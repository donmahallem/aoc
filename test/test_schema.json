{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TestResult": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [{ "type": "integer" }, { "type": "string" }]
          }
        }
      ]
    },
    "SkipLanguages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["go", "python"]
      },
      "description": "Optional list of languages to skip"
    },
    "SignedIntType": {
      "type": "string",
      "enum": ["int", "int16", "int32", "int64"],
      "description": "Signed integer type hint"
    },
    "UnsignedIntType": {
      "type": "string",
      "enum": ["uint", "uint16", "uint32", "uint64"],
      "description": "Unsigned integer type hint"
    },
    "StringType": {
      "type": "string",
      "enum": ["string"],
      "description": "String type hint"
    },
    "ArraySignedIntType": {
      "type": "string",
      "enum": ["[]int", "[]int16", "[]int32", "[]int64"],
      "description": "Signed integer array type hint"
    },
    "ArrayUnsignedIntType": {
      "type": "string",
      "enum": ["[]uint", "[]uint16", "[]uint32", "[]uint64"],
      "description": "Unsigned integer array type hint"
    },
    "ArrayStringType": {
      "type": "string",
      "enum": ["[]string", "[]array"],
      "description": "String array type hint"
    },
    "PartExpectation": {
      "type": "object",
      "properties": {
        "skip_languages": {
          "$ref": "#/definitions/SkipLanguages",
          "description": "Optional list of languages to skip for this part"
        },
        "result": {},
        "type": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "result": {
              "type": "integer"
            },
            "type": {
              "$ref": "#/definitions/SignedIntType"
            }
          },
          "required": ["result", "type"]
        },
        {
          "properties": {
            "result": {
              "type": "integer",
              "minimum": 0
            },
            "type": {
              "$ref": "#/definitions/UnsignedIntType"
            }
          },
          "required": ["result", "type"]
        },
        {
          "properties": {
            "result": {
              "type": "string"
            },
            "type": {
              "$ref": "#/definitions/StringType"
            }
          },
          "required": ["result", "type"]
        },
        {
          "properties": {
            "result": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "type": {
              "$ref": "#/definitions/ArraySignedIntType"
            }
          },
          "required": ["result", "type"]
        },
        {
          "properties": {
            "result": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "type": {
              "$ref": "#/definitions/ArrayUnsignedIntType"
            }
          },
          "required": ["result", "type"]
        },
        {
          "properties": {
            "result": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "$ref": "#/definitions/ArrayStringType"
            }
          },
          "required": ["result", "type"]
        }
      ],
      "additionalProperties": false
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "input": {
          "type": "string",
          "maxLength": 128,
          "description": "Direct string input for the test case"
        },
        "file": {
          "type": "string",
          "description": "Path to a file containing inputs"
        },
        "skip_languages": {
          "$ref": "#/definitions/SkipLanguages",
          "description": "Optional list of languages for which this entire test case should be skipped"
        },
        "part1": {
          "$ref": "#/definitions/PartExpectation",
          "description": "Expected result (and metadata) for Part 1"
        },
        "part2": {
          "$ref": "#/definitions/PartExpectation",
          "description": "Expected result (and metadata) for Part 2"
        },
        "fullData": {
          "type": "boolean",
          "default": false,
          "description": "Marks a full data. All other cases are treated as samples"
        }
      },
      "required": [],
      "oneOf": [
        {
          "required": ["input"]
        },
        {
          "required": ["file"]
        }
      ],
      "anyOf": [
        {
          "required": ["part1"]
        },
        {
          "required": ["part2"]
        }
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "patternProperties": {
    "^[0-9]{2}$": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9_A-Z]+$": {
              "$ref": "#/definitions/TestCase"
            }
          },
          "description": "List of test cases for this day"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
